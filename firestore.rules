rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rifa_vendas/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['n', 'nome', 'pago', 'data', 'forma'])
        && request.resource.data.n is int
        && request.resource.data.n >= 1 && request.resource.data.n <= 200
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 80
        && request.resource.data.pago is bool
        && (request.resource.data.data == null || request.resource.data.data is string)
        && (request.resource.data.forma == null || request.resource.data.forma is string);
    }

    match /rifa_meta/{id} { allow read, write: if true; }
  }
}
